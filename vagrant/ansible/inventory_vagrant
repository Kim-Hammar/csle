# Single-node Vagrant inventory for CSLE installation
# Used with config/single_node.yaml and config/minimal.yaml

[leader]
192.168.56.10 ansible_user=vagrant ansible_ssh_private_key_file=/vagrant/.vagrant/machines/leader/virtualbox/private_key

[worker]
# No workers in single-node configuration

[all:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
